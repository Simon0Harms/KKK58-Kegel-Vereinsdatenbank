[Unit]
Description=KKk58 Vereinsdatenbank (Anschreibliste)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kkk58
Group=kkk58
WorkingDirectory=/opt/kkk58
ExecStart=/usr/bin/node /opt/kkk58/server.js
Restart=on-failure
RestartSec=3

# --- Konfiguration ---
# Alle Umgebungsvariablen werden aus einer eigenen Datei geladen, statt sie hier
# fest einzutragen. Vorlage: kkk58.env.example -> nach kkk58.env (im
# Anwendungsverzeichnis /opt/kkk58) kopieren
# und die Werte anpassen. Das fuehrende "-" macht die Datei optional: fehlt sie,
# startet der Dienst trotzdem und die App nutzt ihre eingebauten Defaults.
#
# WICHTIG: systemd wertet in EnvironmentFile nur ganze Kommentarzeilen (# am
# Zeilenanfang) aus. Inline-Kommentare hinter einem Wert (KEY=wert # ...) werden
# NICHT verlaesslich entfernt und wuerden Teil des Wertes -> in der Env-Datei
# keine Inline-Kommentare verwenden.
EnvironmentFile=-/opt/kkk58/kkk58.env

# --- Haertung ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/kkk58/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
