# KKk58 Matrix-Sidecar – Konfiguration
# Kopiere diese Datei nach /etc/kkk58-matrix.env und trage die Werte ein.
# Kommentare stehen in eigenen Zeilen; Inline-Kommentare (# hinter Werten) werden
# vom Sidecar zwar toleriert, sind aber nicht in jeder Umgebung sauber.

# --- Pflicht ---
KKK_MATRIX_HOMESERVER=https://matrix.example.org
KKK_MATRIX_USER=@kkk58bot:example.org
# Raum-ID (beginnt mit !) oder Alias (beginnt mit #), z. B. #kkk58:example.org
KKK_MATRIX_ROOM=!raumId:example.org

# Nur beim ERSTEN Start nötig – danach wird ein Access-Token gespeichert und das
# Passwort kann wieder entfernt werden.
KKK_MATRIX_PASSWORD=BitteHierDasBotPasswort

# --- Pfade ---
# Von der Node-App geschriebene Datenbank (nur lesend genutzt)
KKK_DB_FILE=/opt/kkk58/data/db.json
# E2EE-Schlüsselspeicher (unbedingt sichern!)
KKK_MATRIX_STORE=/opt/kkk58/matrix-store
KKK_MATRIX_STATE=/opt/kkk58/matrix-store/sidecar-state.json

# --- Verhalten (optional) ---
# Prüfintervall auf Änderungen (Sekunden)
KKK_POLL_SECONDS=15
# Mindestabstand zwischen Backups in Sekunden (0 = nach jeder Änderung)
KKK_BACKUP_MIN_INTERVAL=300
# max. Zeilen je Protokoll-Nachricht
KKK_MAX_LOG_LINES=40
KKK_MATRIX_DEVICE_NAME=KKk58-Backup
# 1 = nur senden, wenn der Raum E2E-verschlüsselt ist (empfohlen)
KKK_REQUIRE_ENCRYPTION=1
