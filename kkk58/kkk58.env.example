# KKk58 Vereinsdatenbank (Node-App) - Konfiguration
# Kopiere diese Datei nach /opt/kkk58/kkk58.env und trage die Werte ein:
#   cp /opt/kkk58/kkk58.env.example /opt/kkk58/kkk58.env
#   chown kkk58:kkk58 /opt/kkk58/kkk58.env && chmod 640 /opt/kkk58/kkk58.env
#
# HINWEIS: Diese Datei wird von systemd als EnvironmentFile eingelesen.
# - Nur KEY=WERT je Zeile, Kommentare stehen in EIGENEN Zeilen (# am Anfang).
# - KEINE Inline-Kommentare (KEY=wert # ...) - systemd entfernt sie nicht
#   zuverlaessig und sie wuerden Teil des Wertes.
# - Werte ohne Anfuehrungszeichen; keine Shell-Expansion.

# --- Basis ---
# HTTP-Port der App
PORT=3000
# NPMplus laeuft in einem SEPARATEN LXC -> App muss von aussen erreichbar sein.
# 0.0.0.0 = alle Interfaces (einfach, funktioniert). Alternativ die konkrete
# IP dieser App-LXC. Zugriff auf Port 3000 per Firewall auf den NPM-LXC
# beschraenken (siehe README, Abschnitt 3).
BIND=0.0.0.0
# Unterpfad, unter dem alles laeuft
BASE_PATH=/kkk58
# Speicherort fuer DB/Secret
DATA_DIR=/opt/kkk58/data
# Session-Cookie nur ueber HTTPS (hinter NPM korrekt)
COOKIE_SECURE=true

# --- Matrix / Login-Links ---
# Oeffentliche Basis-URL - noetig fuer absolute Login-Links beim Matrix-Login.
# Ohne diese Variable wird die URL aus den X-Forwarded-*-Headern von NPMplus
# abgeleitet.
KKK_PUBLIC_URL=https://nas.example.net/kkk58
# Spool-Verzeichnis fuer Matrix-Login-Nachrichten (muss mit dem Sidecar
# uebereinstimmen). Standard: <DATA_DIR>/matrix-outbox - liegt bereits unter
# ReadWritePaths.
#KKK_OUTBOX_DIR=/opt/kkk58/data/matrix-outbox

# --- Erst-Admin (optional) ---
# Nur beim allerersten Start relevant (sonst wird ein Zufallspasswort erzeugt
# und in /opt/kkk58/data/INITIAL-ADMIN.txt geschrieben).
#KKK_ADMIN_USER=admin
#KKK_ADMIN_PASS=BitteAendern
